# Copy to .env for local development: cp .env.example .env
# These are LOCAL-ONLY placeholder values. Never put real or Azure credentials here.
# Real values live in GitHub Actions secrets and Azure Container Apps secrets.

# --- Local SQL Server (docker compose) ---
MSSQL_SA_PASSWORD=Local_Dev_Only_1!
APPLICATIONS_DB_NAME=applications_db
INSIGHTS_DB_NAME=insights_db

# --- applications-api ---
APPLICATIONS_DB_URL=mssql+pyodbc://sa:Local_Dev_Only_1!@sqlserver:1433/applications_db?driver=ODBC+Driver+18+for+SQL+Server&TrustServerCertificate=yes
INSIGHTS_URL=http://insights-api:8001
INSIGHTS_API_KEY=local-dev-shared-key
INSIGHTS_TIMEOUT_SECONDS=2

# --- insights-api ---
INSIGHTS_DB_URL=mssql+pyodbc://sa:Local_Dev_Only_1!@sqlserver:1433/insights_db?driver=ODBC+Driver+18+for+SQL+Server&TrustServerCertificate=yes

# --- Shared ---
# Origin of the static UI; CORS on both services allows only this origin.
CORS_ALLOWED_ORIGIN=http://localhost:5173
LOG_LEVEL=INFO
